    {
      "parameters": {
        "requestMethod": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={{\nJSON.stringify({\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a reasoning agent. Today is \" + $now.format('cccc, MMMM dd, yyyy') + \".\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Query: \" + $node[\"Extract Query\"].json.query + \"\\n\\nSearch Results: \" + ($node[\"HTTP Request\"].json.organic_results?.[0]?.snippet || \"No results found.\")\n    }\n  ]\n})\n}}",
        "headerParametersJson": "{\n  \"Authorization\": \"Bearer YOUR_GROQ_API_KEY\",\n  \"Content-Type\": \"application/json\"\n}"
      },
      "id": "4f113d42-4443-45a8-a4b7-c6e9b04d8099",
      "name": "Reasoning Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        -784,
        32
      ],
      "alwaysOutputData": false,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "functionCode": "return [{ answer: $json.choices?.[0]?.message?.content || \"No answer returned\" }];"
      },
      "id": "067eccfc-c9d8-4f11-84b2-ddb60e7ee285",
      "name": "Extract Answer",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -576,
        128
      ]
    },
    {
      "parameters": {
        "functionCode": "// Get the content from the Critic Agent\nlet criticText = $json.choices?.[0]?.message?.content || \"\";\n// Get the original answer from the Reasoning Agent stage\nlet originalAnswer = $node[\"Extract Answer\"].json.answer;\n\ntry {\n  const res = JSON.parse(criticText);\n  // If the AI returned JSON but the 'final' key is empty, fill it with the original answer\n  if (res.status === \"APPROVED\" && (!res.final || res.final === \"\")) {\n    res.final = originalAnswer;\n  }\n  return [res];\n} catch (e) {\n  // If it's not JSON, assume it's a plain text approval\n  return [{\n    status: \"APPROVED\",\n    final: originalAnswer\n  }];\n}"
      },
      "id": "1b515596-b838-49a7-88a1-e49a63ac4f68",
      "name": "Parse Critic",
      "type": "n8n-nodes-base.function",
