        "bodyParametersJson": "={{\nJSON.stringify({\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a strict AI critic. Always return valid JSON only.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": `Evaluate this answer:\\n\\n${$json.answer}\\n\\nReturn JSON with keys: status, final.`\n    }\n  ]\n})\n}}",
