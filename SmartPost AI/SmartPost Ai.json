    {
      "parameters": {
        "jsCode": "try {\n  // 1. Get the original idea and tone\n  const idea = $node[\"Webhook\"].json.body.idea || \"No Idea Provided\";\n  const tone = $node[\"Webhook\"].json.body.tone || \"Professional\";\n\n  // 2. Helper to find text even if node names change\n  // This searches through previous nodes for the message content\n  const getOutput = (nodeName) => {\n    try {\n      return $node[nodeName].json.choices[0].message.content;\n    } catch (e) {\n      return \"Content not found. Check node name: \" + nodeName;\n    }\n  };\n\n  // 3. Return the EXACT keys your HTML looks for\n  return {\n    idea: idea,\n    tone: tone,\n    linkedin: getOutput(\"LinkedIn Post\"),   // Make sure these match your node names!\n    twitter: getOutput(\"Twitter Thread\"),\n    instagram: getOutput(\"Instagram Caption\"),\n    blog: getOutput(\"Blog Outline\"),\n    timestamp: new Date().toLocaleTimeString()\n  };\n} catch (error) {\n  return { \n    error: error.message,\n    hint: \"Ensure your Groq nodes are named exactly as shown in the code above.\"\n  };\n}"
      },
